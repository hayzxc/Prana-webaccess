generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  password            String
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  issuedCertificates  Certificate[]        @relation("IssuedBy")
  fumigationTrackings FumigationTracking[]
  inspectedSheets     RecordSheet[]        @relation("InspectedBy")

  @@map("users")
}

model Certificate {
  id                    String              @id @default(cuid())
  name                  String
  recipientEmail        String
  recipientName         String
  issueDate             DateTime
  status                CertificateStatus
  fileUrl               String?
  fileName              String?
  fileSize              Int?
  serviceType           String?
  location              String?
  description           String?
  containerNumber       String?             @unique
  noticeId              String?             @unique
  woNumber              String?
  gassingTime           DateTime?
  aerationStartTime     DateTime?
  containerReadyTime    DateTime?
  progressStatus        ProgressStatus?
  phytosanitaryUrl      String?
  phytosanitaryFileName String?
  issuedById            String?             @map("issued_by_id")
  issuedBy              User?               @relation("IssuedBy", fields: [issuedById], references: [id], onDelete: Cascade)
  fumigationTracking    FumigationTracking?
  recordSheet           RecordSheet?

  @@map("certificates")
}

model FumigationTracking {
  id                 String         @id @default(cuid())
  containerNumber    String
  noticeId           String
  woNumber           String?
  companyName        String
  companyEmail       String
  location           String
  gassingTime        DateTime?
  aerationStartTime  DateTime?
  containerReadyTime DateTime?
  progressStatus     ProgressStatus @default(PENDING)
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  certificateId      String?        @unique @map("certificate_id")
  userId             String?        @map("user_id")
  shipperId          String?        @map("shipper_id")
  certificate        Certificate?   @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  shipper            Shipper?       @relation(fields: [shipperId], references: [id], onDelete: Cascade)
  user               User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fumigation_trackings")
}

model Shipper {
  id        String               @id @default(cuid())
  name      String
  email     String               @unique
  createdAt DateTime             @default(now())
  trackings FumigationTracking[]

  @@map("shippers")
}

model RecordSheet {
  id              String       @id @default(cuid())
  commodity       String
  treatmentDate   DateTime
  gasType         String
  concentration   String
  exposureTime    String
  temperature     String
  humidity        String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  containerNumber String?
  fileUrl         String?
  fileName        String?
  certificateId   String?      @unique @map("certificate_id")
  inspectorId     String       @map("inspector_id")
  readings        GasReading[]
  certificate     Certificate? @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  inspector       User         @relation("InspectedBy", fields: [inspectorId], references: [id], onDelete: Cascade)

  @@map("record_sheets")
}

model GasReading {
  id            String      @id @default(cuid())
  timestamp     DateTime
  concentration Float
  temperature   Float
  humidity      Float?
  location      String
  inspector     String
  recordSheetId String      @map("record_sheet_id")
  recordSheet   RecordSheet @relation(fields: [recordSheetId], references: [id], onDelete: Cascade)

  @@map("gas_readings")
}

model GeneratedCertificate {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  fileUrl           String
  fileName          String
  formData          Json
  certificateNumber String
  clientName        String
}

model ConsultationRequest {
  id            String                  @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String?
  companyName   String?
  serviceType   ConsultationServiceType @default(FUMIGATION)
  message       String
  status        ConsultationStatus      @default(PENDING)
  adminNotes    String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("consultation_requests")
}

model ChatMessage {
  id                    String   @id @default(cuid())
  consultationRequestId String   @map("consultation_request_id")
  sender                String
  message               String
  createdAt             DateTime @default(now())

  @@map("chat_messages")
}

enum Role {
  ADMIN
  USER
}

enum CertificateStatus {
  VALID
  EXPIRED
  REVOKED
}

enum ProgressStatus {
  PENDING
  GASSING
  AERATION
  READY
  COMPLETED
}

enum ConsultationServiceType {
  FUMIGATION
  CARGO_SURVEY
  MARINE_SURVEY
  PRESHIPMENT
  INSURANCE
  QUALITY_CONTROL
  ISPM
  GENERAL_CONSULTATION
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
